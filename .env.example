# TakeIn SMS — no secrets required for default local use.
# Copy to .env only if you need overrides (never commit .env).

# Optional: absolute path to adb.exe if not using vendor/platform-tools or PATH
# TAKEIN_ADB_PATH=C:\platform-tools\adb.exe

# Optional: default work directory for XML/SQL/backups
# TAKEIN_WORK_DIR=./output
